<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Description>Native diagram parsing, layout, scenes and SVG for all 33 NornaKit diagram families.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IsPackable>true</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../../PACKAGE.md" Pack="true" PackagePath="README.md" />
    <None Include="../../../LICENSE" Pack="true" PackagePath="LICENSE" />
    <None Include="../../../THIRD_PARTY_NOTICES.md" Pack="true" PackagePath="" />
    <EmbeddedResource Include="../../../Sources/NornaExamples/Resources/examples.json" LogicalName="NornaKit.examples.json" />
    <EmbeddedResource Include="../../../Sources/NornaExamples/Resources/official-examples.json" LogicalName="NornaKit.official-examples.json" />
    <EmbeddedResource Include="../../../Sources/NornaExamples/Resources/official-status.json" LogicalName="NornaKit.official-status.json" />
  </ItemGroup>
</Project>
